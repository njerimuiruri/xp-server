generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  firstName         String
  middleName        String?
  lastName          String
  gender            String
  dob               String
  residenceCounty   String
  residenceLocation String?
  email             String?   @unique
  phoneNumber       String    @unique
  businessNumber    String?
  pin               String
  yearsOfExperience Int?
  otp               String?
  otpExpiry         DateTime?
  isVerified        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  farms             Farm[]
}

model Farm {
  id                     String           @id @default(cuid())
  name                   String
  county                 String
  administrativeLocation String
  size                   Float
  ownership              String
  farmingTypes           String[]
  userId                 String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  breedingRecords        BreedingRecord[]
  employees              EmployeeFarm[]
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  livestock              Livestock[]
}

model Employee {
  id               String            @id @default(cuid())
  firstName        String
  middleName       String?
  lastName         String
  phone            String
  emergencyContact String?
  idNumber         String            @unique
  idPhoto          String?
  employeeType     String
  dateOfEmployment DateTime
  endDate          DateTime?
  role             String
  customRole       String?
  paymentSchedule  String
  salary           Float
  typeOfEngagement String?
  workSchedule     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  benefits         EmployeeBenefit[]
  farms            EmployeeFarm[]
}

model EmployeeFarm {
  id         String   @id @default(cuid())
  employeeId String
  farmId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  farm       Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([employeeId, farmId])
}

model EmployeeBenefit {
  id         String   @id @default(cuid())
  employeeId String
  name       String
  amount     Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, name])
}

model Livestock {
  id           String           @id @default(cuid())
  farmId       String
  category     String
  type         String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  status       String           @default("active")
  breedingDam  BreedingRecord[] @relation("dam")
  breedingSire BreedingRecord[] @relation("sire")
  healthEvent  HealthEvent[]
  farm         Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  mammal       Mammal?
  mortality    Mortality?
  offspring    Offspring[]
  poultry      Poultry?
  sale         Sale?
  transfer     Transfer[]
}

model Mammal {
  id               String    @id @default(cuid())
  livestockId      String    @unique
  idNumber         String    @unique
  breedType        String
  phenotype        String?
  dateOfBirth      String
  gender           String
  sireId           String?
  sireCode         String?
  damId            String?
  damCode          String?
  birthWeight      Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  currentWeight    Float?
  lastWeighingDate DateTime?
  livestock        Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model Poultry {
  id                   String    @id @default(cuid())
  livestockId          String    @unique
  flockId              String    @unique
  dateOfStocking       DateTime
  gender               String
  initialQuantity      Int
  currentQuantity      Int
  breedType            String
  sourceOfBirds        String
  initialAverageWeight Float?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  currentAverageWeight Float?
  lastWeighingDate     DateTime?
  mortalityRate        Float?    @default(0)
  livestock            Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model Mortality {
  id          String    @id @default(cuid())
  livestockId String    @unique
  date        DateTime
  cause       String
  description String?
  reportedBy  String?
  attachments String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model HealthEvent {
  id            String    @id @default(cuid())
  livestockId   String
  eventType     String
  date          DateTime
  description   String
  performedBy   String?
  medications   String[]
  dosage        String?
  cost          Float?
  nextScheduled DateTime?
  attachments   String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  livestock     Livestock @relation(fields: [livestockId], references: [id])
}

model Transfer {
  id                  String    @id @default(cuid())
  livestockId         String
  fromFarmId          String
  toFarmId            String
  transferDate        DateTime
  reason              String?
  transportMethod     String?
  handlingPrecautions String?
  attachments         String[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  livestock           Livestock @relation(fields: [livestockId], references: [id])
}

model Sale {
  id            String    @id @default(cuid())
  livestockId   String    @unique
  saleDate      DateTime
  buyerName     String
  buyerContact  String?
  saleAmount    Float
  paymentMethod String
  receiptNumber String?
  notes         String?
  attachments   String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  livestock     Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model BreedingRecord {
  id                String      @id @default(cuid())
  damId             String
  sireId            String?
  purpose           String
  strategy          String
  serviceType       String
  serviceDate       DateTime
  numServices       Int         @default(1)
  firstHeatDate     DateTime?
  sireCode          String?
  aiType            String?
  aiSource          String?
  aiCost            Float?
  gestationDays     Int
  expectedBirthDate DateTime
  birthRecorded     Boolean     @default(false)
  birthDate         DateTime?
  deliveryMethod    String?
  youngOnes         Int?
  birthWeight       Float?
  litterWeight      Float?
  offspringSex      String?
  farmId            String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  dam               Livestock   @relation("dam", fields: [damId], references: [id], onDelete: Cascade)
  farm              Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  sire              Livestock?  @relation("sire", fields: [sireId], references: [id])
  offspring         Offspring[]
}

model Offspring {
  id               String         @id @default(cuid())
  breedingRecordId String
  livestockId      String?
  offspringId      String
  sex              String
  birthWeight      Float?
  notes            String?
  status           String         @default("alive")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  breedingRecord   BreedingRecord @relation(fields: [breedingRecordId], references: [id], onDelete: Cascade)
  livestock        Livestock?     @relation(fields: [livestockId], references: [id])
}
