generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  firstName         String
  middleName        String?
  lastName          String
  gender            String
  dob               String
  residenceCounty   String
  residenceLocation String?
  constituency      String?
  residenceConstituency  String?
  email             String?   @unique
  phoneNumber       String    @unique
  nationalId        String?   @unique
  businessNumber    String?
  pin               String
  yearsOfExperience Int?
  otp               String?
  otpExpiry         DateTime?
  isVerified        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  farms             Farm[]
  feedingPrograms   FeedingProgram[]
}

model Farm {
  id                     String         @id @default(cuid())
  name                   String
  county                 String
  administrativeLocation String
  size                   Float
  ownership              String
  farmingTypes           String[]
  userId                 String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  employees              EmployeeFarm[]
  livestock              Livestock[]
  breedingRecords        BreedingRecord[]
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedingPrograms        FeedingProgram[]
}

model Employee {
  id               String            @id @default(cuid())
  firstName        String
  middleName       String?
  lastName         String
  phone            String
  emergencyContact String?
  idNumber         String            @unique
  idPhoto          String?
  employeeType     String
  dateOfEmployment DateTime
  endDate          DateTime?
  role             String
  customRole       String?
  paymentSchedule  String
  salary           Float
  typeOfEngagement String?
  workSchedule     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  benefits         EmployeeBenefit[]
  farms            EmployeeFarm[]
}

model EmployeeFarm {
  id         String   @id @default(cuid())
  employeeId String
  farmId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  farm       Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([employeeId, farmId])
}

model EmployeeBenefit {
  id         String   @id @default(cuid())
  employeeId String
  name       String
  amount     Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, name])
}

model Livestock {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  category  String // mammal or poultry
  type      String // e.g., dairy cow, beef cattle, layer, broiler
  status    String   @default("active") // active, deceased, sold, transferred
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  mammal      Mammal?
  poultry     Poultry?
  mortality   Mortality?
  healthEvent HealthEvent[]
  transfer    Transfer[]
  sale        Sale?
  breedingDam BreedingRecord[] @relation("dam")
  breedingSire BreedingRecord[] @relation("sire")
  offspring   Offspring[]
}

model Mammal {
  id               String    @id @default(cuid())
  livestockId      String    @unique
  idNumber         String    @unique
  breedType        String
  phenotype        String?
  dateOfBirth      String
  gender           String
  sireId           String?
  sireCode         String?
  damId            String?
  damCode          String?
  birthWeight      Float?
  currentWeight    Float?
  lastWeighingDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  livestock        Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model Poultry {
  id                   String    @id @default(cuid())
  livestockId          String    @unique
  flockId              String    @unique
  dateOfStocking       DateTime
  gender               String
  initialQuantity      Int
  currentQuantity      Int
  breedType            String
  sourceOfBirds        String
  initialAverageWeight Float?
  currentAverageWeight Float?
  lastWeighingDate     DateTime?
  mortalityRate        Float?    @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  livestock            Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model Mortality {
  id             String    @id @default(cuid())
  livestockId    String    @unique
  date           DateTime
  cause          String
  description    String?
  reportedBy     String?
  attachments    String[]  // URLs to photos or documents
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  livestock      Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model HealthEvent {
  id             String    @id @default(cuid())
  livestockId    String
  eventType      String    // vaccination, treatment, check-up, etc.
  date           DateTime
  description    String
  performedBy    String?
  medications    String[]
  dosage         String?
  cost           Float?
  nextScheduled  DateTime?
  attachments    String[] // URLs to photos or documents
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  livestock      Livestock @relation(fields: [livestockId], references: [id])
}

model Transfer {
  id                 String    @id @default(cuid())
  livestockId        String
  fromFarmId         String
  toFarmId           String
  transferDate       DateTime
  reason             String?
  transportMethod    String?
  handlingPrecautions String?
  attachments        String[] // URLs to photos or documents
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  livestock          Livestock @relation(fields: [livestockId], references: [id])
}

model Sale {
  id              String    @id @default(cuid())
  livestockId     String    @unique
  livestock       Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  saleDate        DateTime
  buyerName       String
  buyerContact    String?
  saleAmount      Float
  paymentMethod   String
  receiptNumber   String?
  notes           String?
  attachments     String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model BreedingRecord {
  id            String    @id @default(cuid())
  damId         String    
  dam           Livestock @relation("dam", fields: [damId], references: [id], onDelete: Cascade)
  sireId        String?   
  sire          Livestock? @relation("sire", fields: [sireId], references: [id], onDelete: SetNull)
  purpose       String    
  strategy      String    
  serviceType   String    
  serviceDate   DateTime
  numServices   Int       @default(1)
  firstHeatDate DateTime?
  
  // AI specific fields
  sireCode      String?   // For AI, the code of the semen used
  aiType        String?   // Sex Cell Semen, Regular AI
  aiSource      String?   // Local, Imported
  aiCost        Float?    // Cost of AI service
  
  // Gestation details
  gestationDays Int       // Expected gestation period in days
  expectedBirthDate DateTime
  
  // Birth details (if recorded)
  birthRecorded Boolean   @default(false)
  birthDate     DateTime?
  deliveryMethod String?  // Natural Birth, Assisted, Cesarean
  youngOnes     Int?      // Number of offspring
  birthWeight   Float?    // For single births
  litterWeight  Float?    // For multiple births (e.g., swine)
  offspringSex  String?   // Description of offspring sex distribution
  
  // Relations
  offspring     Offspring[]
  
  farmId        String    // For easy filtering by farm
  farm          Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Offspring {
  id              String    @id @default(cuid())
  breedingRecordId String
  breedingRecord  BreedingRecord @relation(fields: [breedingRecordId], references: [id], onDelete: Cascade)
  livestockId     String?   // If registered as livestock
  livestock       Livestock? @relation(fields: [livestockId], references: [id], onDelete: SetNull)
  offspringId     String    // ID/tag number assigned to the offspring
  sex             String    // Male, Female
  birthWeight     Float?
  notes           String?
  status          String    @default("alive") // alive, deceased, sold, transferred
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FeedingProgram {
  id                   String       @id @default(cuid())
  farmId               String
  userId               String
  programType          String // Single Animal or Group
  animalId             String?
  animalType           String?
  lifecycleStages      String[]
  groupId              String?
  groupType            String?
  groupLifecycleStages String[]
  feedType             String // Basal Feeds or Basal Feed + Concentrates + Supplements
  timeOfDay            String[]
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  farm                 Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  basal                FeedDetails  @relation("BasalFeed", fields: [basalId], references: [id])
  basalId              String       @unique

  concentrate          FeedDetails? @relation("ConcentrateFeed", fields: [concentrateId], references: [id])
  concentrateId        String?      @unique

  supplement           FeedDetails? @relation("SupplementFeed", fields: [supplementId], references: [id])
  supplementId         String?      @unique
}

model FeedDetails {
  id                 String            @id @default(cuid())
  feedType           String
  source             String
  schedule           String
  quantity           Float
  date               DateTime
  cost               Float?
  supplier           String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  basalProgram       FeedingProgram?   @relation("BasalFeed")
  concentrateProgram FeedingProgram?   @relation("ConcentrateFeed")
  supplementProgram  FeedingProgram?   @relation("SupplementFeed")
}
